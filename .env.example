# --- Required (Google Photos OAuth) ---
# See README → "GCP — Enable the Photos Picker API"
MEMORYLANE_GOOGLE_CLIENT_ID=
MEMORYLANE_GOOGLE_CLIENT_SECRET=

# --- Storage backend ---
# Default (all unset): photos go to the local MinIO container (no AWS account needed).
#
# To point at a real AWS S3 bucket (provisioned by `terraform apply -target=module.s3`):
#   1. Uncomment the four AWS vars below.
#   2. Set MEMORYLANE_S3_ENDPOINT_URL to an empty string so boto3 picks the real endpoint
#      for MEMORYLANE_AWS_REGION.
#
# MEMORYLANE_S3_ENDPOINT_URL=
# MEMORYLANE_S3_BUCKET_PHOTOS=  
# MEMORYLANE_AWS_ACCESS_KEY_ID=
# MEMORYLANE_AWS_SECRET_ACCESS_KEY=
# MEMORYLANE_AWS_REGION=us-east-1

# --- Phase 3 — Agent service ---
MEMORYLANE_ANTHROPIC_API_KEY=
MEMORYLANE_LANGSMITH_API_KEY=
MEMORYLANE_LANGSMITH_PROJECT=memorylane-agent
